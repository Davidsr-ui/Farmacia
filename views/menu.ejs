<%- include('partials/head') %>
<h3 class="mb-4">Bienvenido, <%= user.nombre %></h3>
<div class="row g-3">
  <% menu.filter(m => m.href !== '/menu').forEach(m => { %>
    <div class="col-md-4">
      <a class="text-decoration-none" href="<%= m.href %>">
        <div class="card shadow-sm h-100"><div class="card-body text-center py-5">
          <h5><%= m.texto %></h5>
        </div></div>
      </a>
    </div>
  <% }) %>
</div>
<%- include('partials/foot') %>