<%- include('partials/head') %>
<div class="d-flex justify-content-between mb-3">
  <h3>Medicamentos</h3>
  <button class="btn btn-primary d-none" id="btn-nuevo"><i class="bi bi-plus-lg"></i> Nuevo</button>
</div>

<div class="table-responsive">
<table class="table table-striped bg-white shadow-sm">
  <thead class="table-primary">
    <tr>
      <th>Código</th><th>Descripción</th><th>Marca</th><th>Presentación</th><th>Tipo</th><th>Especialidad</th>
      <th>P. Unit.</th><th>P. Present.</th><th>Stock</th><th>Fabricación</th><th>Vencimiento</th>
      <th class="text-end">Acciones</th>
    </tr>
  </thead>
  <tbody id="tabla"></tbody>
</table>
</div>

<div class="modal fade" id="modal" tabindex="-1">
  <div class="modal-dialog modal-lg"><div class="modal-content">
    <form id="form" novalidate>
      <div class="modal-header">
        <h5 class="modal-title" id="modal-titulo"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="errores" class="alert alert-danger d-none"></div>
        <input type="hidden" name="CodMedicamento">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Descripción</label>
            <input name="descripcionMed" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">Marca</label>
            <input name="marca" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">Presentación</label>
            <input name="presentacion" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">Tipo</label>
            <select name="CodTipoMed" id="sel-tipo" class="form-select"></select></div>
          <div class="col-md-6"><label class="form-label">Especialidad</label>
            <select name="CodEspec" id="sel-esp" class="form-select"></select></div>
          <div class="col-md-6"><label class="form-label">Stock</label>
            <input name="stock" type="number" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">Precio unitario</label>
            <input name="precioVentaUni" type="number" step="0.01" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">Precio presentación</label>
            <input name="precioVentaPres" type="number" step="0.01" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">Fecha fabricación</label>
            <input name="fechaFabricacion" type="date" class="form-control"></div>
          <div class="col-md-6"><label class="form-label">Fecha vencimiento</label>
            <input name="fechaVencimiento" type="date" class="form-control"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary">Guardar</button>
      </div>
    </form>
  </div></div>
</div>
<%- include('partials/foot', { script: 'medicamentos' }) %>