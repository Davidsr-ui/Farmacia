<%- include('partials/head') %>
<div class="d-flex justify-content-between mb-3">
  <h3>Laboratorios</h3>
  <button class="btn btn-primary" id="btn-nuevo"><i class="bi bi-plus-lg"></i> Nuevo</button>
</div>

<div class="table-responsive">
<table class="table table-striped bg-white shadow-sm">
  <thead class="table-primary">
    <tr><th>Código</th><th>Razón social</th><th>Dirección</th><th>Teléfono</th><th>Email</th><th>Contacto</th><th class="text-end">Acciones</th></tr>
  </thead>
  <tbody id="tabla"></tbody>
</table>
</div>

<div class="modal fade" id="modal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form id="form" novalidate>
      <div class="modal-header">
        <h5 class="modal-title" id="modal-titulo"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="errores" class="alert alert-danger d-none"></div>
        <input type="hidden" name="CodLab">
        <div class="mb-3"><label class="form-label">Razón social</label><input name="razonSocial" class="form-control"></div>
        <div class="mb-3"><label class="form-label">Dirección</label><input name="direccion" class="form-control"></div>
        <div class="row">
          <div class="col mb-3"><label class="form-label">Teléfono</label><input name="telefono" class="form-control"></div>
          <div class="col mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control"></div>
        </div>
        <div class="mb-3"><label class="form-label">Contacto</label><input name="contacto" class="form-control"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary">Guardar</button>
      </div>
    </form>
  </div></div>
</div>
<%- include('partials/foot', { script: 'laboratorios' }) %>