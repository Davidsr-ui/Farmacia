<%- include('partials/head') %>
<style>
  body > .container { max-width: 100%; padding: 0 !important; }
  .login-split { min-height: 100vh; }
  .login-imagen {
    background: url('/img/farmacia.jpg') center / cover no-repeat;
    background-color: #0d6efd; /* respaldo si no hay imagen */
  }
</style>

<div class="container-fluid">
  <div class="row login-split g-0">

    <!-- Izquierda: formulario -->
    <div class="col-md-6 order-1 d-flex align-items-center justify-content-center bg-white">
      <div class="w-100 p-4" style="max-width: 420px;">
        <h2 class="fw-bold text-primary mb-1">Farmacia</h2>
        <p class="text-muted mb-4">Inicie sesión para continuar</p>

        <div id="errores" class="alert alert-danger d-none"></div>

        <form id="form-login" novalidate>
          <div class="mb-3">
            <label class="form-label">Correo</label>
            <input name="email" type="email" class="form-control form-control-lg">
          </div>
          <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input name="password" type="password" class="form-control form-control-lg">
          </div>
          <button class="btn btn-primary btn-lg w-100">Ingresar</button>
        </form>

        <p class="mt-4 mb-0 text-center">¿No tiene cuenta? <a href="/registro">Regístrese</a></p>
      </div>
    </div>

    <!-- Derecha: imagen (oculta en celulares) -->
    <div class="col-md-6 order-2 d-none d-md-block login-imagen"></div>

  </div>
</div>
<%- include('partials/foot', { script: 'login' }) %>