<%- include('partials/head') %>
<div class="d-flex justify-content-between mb-3">
  <h3>Órdenes de compra</h3>
  <button class="btn btn-primary" id="btn-nuevo"><i class="bi bi-plus-lg"></i> Nueva orden</button>
</div>

<div class="table-responsive">
<table class="table table-striped bg-white shadow-sm">
  <thead class="table-primary">
    <tr><th>N°</th><th>Fecha</th><th>Laboratorio</th><th>Factura</th><th>Situación</th><th>Total</th><th class="text-end">Acciones</th></tr>
  </thead>
  <tbody id="tabla"></tbody>
</table>
</div>

<!-- Modal nueva orden -->
<div class="modal fade" id="modal" tabindex="-1">
  <div class="modal-dialog modal-xl"><div class="modal-content">
    <form id="form" novalidate>
      <div class="modal-header">
        <h5 class="modal-title">Nueva orden de compra</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="errores" class="alert alert-danger d-none"></div>
        <div class="row g-3 mb-3">
          <div class="col-md-3"><label class="form-label">Fecha de emisión</label><input name="fechaEmision" type="date" class="form-control"></div>
          <div class="col-md-4"><label class="form-label">Laboratorio</label><select name="CodLab" id="sel-lab" class="form-select"></select></div>
          <div class="col-md-3"><label class="form-label">N° factura proveedor</label><input name="NrofacturaProv" class="form-control"></div>
          <div class="col-md-2"><label class="form-label">Situación</label>
            <select name="Situacion" class="form-select"><option>Pendiente</option><option>Recibida</option><option>Anulada</option></select></div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
          <h6 class="mb-0">Detalle</h6>
          <button type="button" class="btn btn-sm btn-outline-primary" id="btn-linea"><i class="bi bi-plus"></i> Agregar medicamento</button>
        </div>
        <table class="table table-sm align-middle">
          <thead><tr><th>Medicamento</th><th style="width:120px">Cantidad</th><th style="width:140px">Precio</th><th style="width:110px" class="text-end">Subtotal</th><th style="width:50px"></th></tr></thead>
          <tbody id="lineas"></tbody>
          <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end" id="total">0.00</th><th></th></tr></tfoot>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary">Guardar orden</button>
      </div>
    </form>
  </div></div>
</div>

<!-- Modal ver detalle -->
<div class="modal fade" id="modal-ver" tabindex="-1">
  <div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title" id="ver-titulo"></h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body" id="ver-cuerpo"></div>
  </div></div>
</div>
<%- include('partials/foot', { script: 'ordenes-compra' }) %>